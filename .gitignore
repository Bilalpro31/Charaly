# Build outputs
build/
.gradle/
.cxx/
*.apk
*.aab
*.so

# Kotlin compiler scratch: session markers and error logs from a local build.
.kotlin/

# Local machine configuration: must never be committed.
local.properties

# IDE
.idea/
*.iml
.DS_Store

# llama.cpp is fetched by scripts/setup-llama.sh, not vendored.
app/src/main/cpp/llama.cpp/

# Imported models must never enter the repository.
*.gguf

# Python bytecode. scripts/generate-story-art.py is tracked; the cache it leaves behind
# is not, and it differs per interpreter version so it would only ever show up as noise.
__pycache__/
*.py[cod]

# Native build verification output from scripts/verify-native-arm64.sh.
/tmp-charaly-native-verify/
