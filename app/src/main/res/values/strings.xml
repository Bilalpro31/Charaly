<?xml version="1.0" encoding="utf-8"?>
<!--
  English is the reference locale.

  Every user-visible string in the app module lives here. The runtime module cannot use
  Android resources (it is plain Kotlin/JVM, unit tested without a device), so it carries
  its own catalogue in dev.charaly.runtime.presentation.Loc - and LocaleResourceParityTest
  asserts the two agree on their shared keys, so the two cannot drift apart silently.
-->
