<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ equivalent of backup_rules.xml. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="charaly" />
        <exclude domain="file" path="models" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="charaly" />
        <exclude domain="file" path="models" />
    </device-transfer>
</data-extraction-rules>
