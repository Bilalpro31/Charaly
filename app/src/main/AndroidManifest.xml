<?xml version="1.0" encoding="utf-8"?>
<!--
  Charaly is local-first.

  INTERNET is declared for exactly one feature: downloading a GGUF model from the
  Hugging Face Hub when the user asks for one. It is not used for story data.

  What never touches the network, and is enforced by code rather than by convention:
    * conversations and transcripts        - generated and stored on device
    * memories and character knowledge      - local JSON documents
    * world state and the event log         - local
    * model inference                        - llama.cpp, in-process, via JNI
    * world simulation and event evaluation  - pure Kotlin, no I/O at all

  There is no telemetry, no analytics, no cloud account, no API key and no server.
  Deleting the model directory, or never downloading a model at all, leaves every
  other feature working in airplane mode.

  ACCESS_NETWORK_STATE exists so the UI can say "Offline Ready" accurately rather
  than showing a model download button that is about to fail.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      Reading a GGUF the user picks from their own storage. ACTION_OPEN_DOCUMENT
      via the Storage Access Framework grants a per-file URI without any broad
      storage permission.
    -->
    <application
        android:name=".CharalyApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Charaly"
        android:usesCleartextTraffic="false"
        tools:targetApi="34">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Charaly">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
